{
  "name": "task-list-assets",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/task_list/static/input.css -o src/task_list/static/app.css --minify",
    "build:js": "cp node_modules/htmx.org/dist/htmx.min.js src/task_list/static/htmx.min.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "htmx.org": "2.0.6",
    "tailwindcss": "3.4.17"
  }
}
